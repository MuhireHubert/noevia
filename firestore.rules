rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Menu items: anyone can read (the public Menu page), only signed-in
    // staff can add/edit/delete.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: any customer can create one (checkout doesn't require an
    // account), but only signed-in staff can read the order list or
    // change an order's status. Nobody can delete an order from the
    // client — that's intentional, keep the paper trail.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
